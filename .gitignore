# 生成产物（生图插件写入的图片）
generated-images/

# 临时文件与测试脚手架
.dib-scratch/
probe.txt
*.log

# 依赖
node_modules/

# 验收运行时的临时目录（工作区内，便于受限沙箱也能 mkdtemp）
.dib-tmp*/

# 编辑器 / 系统
.DS_Store
Thumbs.db
*.swp

# 一次性诊断探针（开发期排查用，不入库）
.dib-verify/probe-*.mjs
# 同上，外加一次性诊断脚本；沙箱内不许删文件，用忽略规则挡住即可
.dib-verify/*.tmp.mjs
.dib-verify/*.tmp.cjs
# 一次性诊断脚本的其它命名（同上，沙箱内删不掉）
.dib-verify/describe-*.mjs
.dib-mut/

# 参考 README 的本地缓存（抓下来对照写法用的，不入库）
.ref-*.tmp*
.refcache-test.tmp
# 提交消息的临时文件（本机提交用；沙箱内删不掉，用忽略规则挡住）
.dib-verify/*.tmp.txt

# 图标配色验收时渲染出来的预览图（开发期肉眼比对用，不入库也不入包）
preview-*.png

# Windows 文件权限诊断的本地报告与回滚备份（只对本机有意义，且含机器路径，不入库）
.dib-acl-report/
