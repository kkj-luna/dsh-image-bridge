# 生成产物（生图插件写入的图片）
generated-images/

# 临时文件与测试脚手架
.dib-scratch/
probe.txt
*.log

# 依赖
node_modules/

# 历史副本：已被 plugins/dsh-image-bridge-v4 取代，只在本机保留、不纳入版本控制
# （本机 Harness profile 里可能还有指向这些目录的 link 依赖，删磁盘文件会弄坏正在跑的插件）
dsh-image-bridge/
image-bridge/
plugins/dsh-image-bridge/
plugins/dsh-image-bridge-live/
plugins/dsh-image-bridge-v3/

# 编辑器 / 系统
.DS_Store
Thumbs.db
*.swp

# 一次性诊断探针（开发期排查用，不入库）
.dib-verify/probe-*.mjs
# 同上，外加一次性诊断脚本；沙箱内不许删文件，用忽略规则挡住即可
.dib-verify/*.tmp.mjs
.dib-verify/*.tmp.cjs
# 一次性诊断脚本的其它命名（同上，沙箱内删不掉）
.dib-verify/describe-*.mjs
.dib-mut/

# 参考 README 的本地缓存（抓下来对照写法用的，不入库）
.ref-*.tmp*
.refcache-test.tmp
# 提交消息的临时文件（本机提交用；沙箱内删不掉，用忽略规则挡住）
.dib-verify/*.tmp.txt
