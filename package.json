{
  "name": "kkj-luna-dsh-image-bridge",
  "version": "0.4.3",
  "license": "MIT",
  "description": "生图桥：给没有生图/修图能力的模型接入外部生图模型。在 Web 界面配置 API 与 Key，模型即可直接调用生图/改图能力。",
  "type": "module",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkj-luna/dsh-image-bridge.git"
  },
  "homepage": "https://github.com/kkj-luna/dsh-image-bridge#readme",
  "bugs": {
    "url": "https://github.com/kkj-luna/dsh-image-bridge/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "image-generation",
    "image-edit",
    "openai-compatible"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node .dib-verify/verify-manifest.mjs && node .dib-verify/verify-client.mjs && node .dib-verify/verify-host.mjs && node .dib-verify/verify-security.mjs && node .dib-verify/verify-resolve.mjs && node .dib-verify/verify-upgrade.mjs",
    "prepublishOnly": "node .dib-verify/verify-manifest.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "icon": "./icon.svg",
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md",
    "README.en.md",
    "docs/manual.md",
    "docs/manual.en.md",
    "docs/marketplace.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-ui-attachment",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
